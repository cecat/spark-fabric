# FALDA distiller — environment (Phase 6). One instance PER TENANT.
# Copy to ~/.config/falda/distiller-<tenant>.env (0600) and fill in.
# Source of truth for the runtime knobs; the systemd unit reads this file.
#
# The distiller script itself is UN-VENDORED at ~/code/falda/falda_distiller.py
# (pin recorded in this dir's README). We only version the config + unit here.

# --- FALDA gateway ---
# MUST set explicitly: the script defaults to :8078, but our gateway is :8077.
FALDA_URL=http://127.0.0.1:8077
# One tenant per process. Distilled atoms/scenes/core land in THIS tenant's store.
FALDA_TENANT=luoji
# Empty = the tenant's private "self" store (correct default; do NOT distill into
# a shared pool unless that's deliberately wanted).
FALDA_POOL=

# --- LLM route (LiteLLM -> argo-shim -> Argo -> Opus) ---
# MUST set explicitly: the script defaults to gpt-4o-mini.
# Use the explicit claudeopus47 model name (NOT the hermes-agent alias), so
# re-pointing Gandalf's model later can't silently change what the distiller runs.
LLM_BASE_URL=http://127.0.0.1:4000/v1
LLM_API_KEY=dummy-not-used-by-argo
DISTILLER_MODEL=claudeopus47

# --- cadence knobs (config-driven, no magic numbers) ---
# T0->T1: extract atoms once this many new stream turns have accumulated.
L1_EVERY_N=10
# T0->T1 window: turns per extraction pass. Smaller = less under-extraction on
# big blobs (see FALDA README / VERIFY 6 note). 12 is the script default.
L1_CHUNK_TURNS=12
# T1->T2 scene synthesis cadence (seconds).
L2_INTERVAL_S=3600
# T2->T3 core synthesis cadence (seconds).
L3_INTERVAL_S=21600
# Continuous-loop poll interval (seconds). Ignored by --once.
DISTILLER_POLL_S=120
