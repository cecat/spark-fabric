# FALDA gateway environment — rendered to ~/.config/falda/falda.env (mode 0600)
# by ops/apply-fabric.sh. No secrets here (the local embedder is keyless), but
# keep it out of the repo as a matter of convention.

FALDA_PORT=8077
# Loopback only. FALDA has NO AUTH — never set this to 0.0.0.0 or a routable IP
# unless it sits behind an authenticating proxy. Default in code is 127.0.0.1;
# set explicitly here so intent is visible.
FALDA_HOST=127.0.0.1

# Single data root: holds the SQLite DB, scene/core blobs, and the embedding
# lock manifest (EMBEDDING.json). NOTE: falda's README still documents the old
# FALDA_DB / FALDA_BLOBS split — the running gateway (src/gateway.ts) uses
# FALDA_ROOT. Verified against source on 2026-07-28.
FALDA_ROOT=REPLACE_ME_HOME/.falda/data

# Embedder — remote, pointing at the local Ollama from Phase 1. Setting
# FALDA_EMBED_BASE_URL is what selects "remote" mode.
FALDA_EMBED_BASE_URL=http://127.0.0.1:11434/v1
FALDA_EMBED_API_KEY=x
FALDA_EMBED_MODEL=nomic-embed-text

# Must match the embedder's output dimension (nomic-embed-text = 768). The
# gateway writes EMBEDDING.json on first boot and FATAL-exits on a later
# model/dim mismatch, so changing either after first boot requires re-embedding.
FALDA_DIM=768
