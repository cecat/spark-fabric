[Unit]
Description=FALDA gateway — tiered long-term memory (loopback only, NO AUTH)
After=network-online.target ollama.service
Wants=network-online.target
# Embedder must be up first: FALDA calls it on every read and write.
Requires=ollama.service

[Service]
Type=simple
WorkingDirectory=%h/code/falda
# Pin the ABSOLUTE node path. better-sqlite3 is a native module (ABI 127 under
# node v22); npm ci / npm rebuild MUST run under this same binary or the gateway
# dies with ERR_DLOPEN_FAILED. Do NOT rely on PATH. (System /usr/bin/node is
# v18 and fails falda's engines>=20 requirement.)
Environment=PATH=%h/.nvm/versions/node/v22.22.3/bin:/usr/bin:/bin
ExecStart=%h/.nvm/versions/node/v22.22.3/bin/node %h/code/falda/node_modules/.bin/tsx %h/code/falda/src/gateway.ts
EnvironmentFile=%h/.config/falda/falda.env
Restart=on-failure
RestartSec=3
StandardOutput=append:%h/.falda/gateway.log
StandardError=append:%h/.falda/gateway.log

[Install]
WantedBy=default.target
