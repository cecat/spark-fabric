# UMP memory server — environment (Phase 10).
# Copy to ~/.config/ump/ump.env (0600). Read by the systemd unit.
#
# UMP is the memory INTERCHANGE FORMAT (an MCP server), complementary to FALDA's
# engine. One shared did:key owner for BOTH agents so their memories are portable
# and mutually readable.

# Data + key material. The owner did:key is derived from key.json (0600) here.
UMP_DIR=/home/catlett/.ump

# HTTP port. NOTE: the plan's example uses :4000, but LiteLLM already owns :4000
# on this box — so we use :4100.
UMP_HTTP=4100

# Loopback only (the wrapper defaults to this; set explicitly for clarity).
# Do NOT widen without an authenticating proxy — UMP has no transport auth.
UMP_HOST=127.0.0.1

# json (single portable memory.ump.json) | markdown (dir of .md).
UMP_STORE=json

# Audit trail on (who wrote what).
UMP_AUDIT=on

# Absolute path to the global package's dist/index.js (ESM can't resolve a global
# package by name from an out-of-tree wrapper). Derived from `npm root -g`.
UMP_CORE_INDEX=/home/catlett/.nvm/versions/node/v22.22.3/lib/node_modules/@universalmemoryprotocol/core/dist/index.js
