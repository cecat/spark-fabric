# FALDA -> UMP mirror — environment (Phase 11).
# Copy to ~/.config/ump/mirror.env (0600). Read by falda-ump-mirror.service.
#
# One-directional: reads FALDA shared-corpus atoms, writes UMP records. FALDA is
# the single source of truth; nothing here ever writes back to FALDA.

# --- FALDA source (read-only) ---
FALDA_URL=http://127.0.0.1:8077
# The POOL is what scopes the read to shared memory. Tenant is just a required
# param for the query API; any tenant that can see the pool works — it does NOT
# widen what is read. Private "self" stores are never touched.
MIRROR_TENANT=gandalf
MIRROR_POOL=shared-corpus

# --- UMP sink (write) ---
UMP_URL=http://127.0.0.1:4100
# REQUIRED: the ONE shared did:key owner (from ~/.ump/key.json, echoed by
# /.well-known/ump.json). Must match the UMP server's owner or recall silently
# returns nothing. No default on purpose — the mirror refuses to run unset.
UMP_OWNER=did:key:z6Mksh6F8K7vFaPpzmstzqR2Fj9zaWwJpHC5q1QCVAYFDqbw
# Portable-but-shared: this is deliberately-shared memory, not private, not public.
UMP_VISIBILITY=shared
# A FALDA atom does not record which agent authored it, so we do NOT fabricate one
# — actor_kind is honestly "import" and actor is the owner the mirror runs as.
UMP_ACTOR_KIND=import
UMP_METHOD=falda-shared-corpus-mirror

# --- runtime knobs (config-driven, no magic numbers) ---
# Continuous-loop poll interval (seconds). Ignored by --once.
MIRROR_POLL_S=300
# Atoms per /atoms/query page.
MIRROR_PAGE_LIMIT=200
# Re-query this many seconds before the last watermark so same-second atoms are
# never skipped; the seen-id set absorbs the overlap.
MIRROR_LOOKBACK_S=5
MIRROR_HTTP_TIMEOUT=15

# State + log live next to the UMP store (0600 dir ~/.ump). mirror_state.json
# holds the watermark + the set of already-mirrored FALDA atom ids.
MIRROR_STATE=/home/catlett/.ump/mirror_state.json
MIRROR_LOG=/home/catlett/.ump/mirror.log
