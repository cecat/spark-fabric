[Unit]
Description=FALDA embedder — Ollama serving nomic-embed-text (loopback only)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Loopback bind ONLY — nothing off-box. FALDA reaches this at 127.0.0.1:11434.
Environment=OLLAMA_HOST=127.0.0.1:11434
Environment=OLLAMA_MODELS=%h/.ollama/models
# Embedder runs on CPU by design (nomic-embed-text is a single forward pass);
# no GPU scheduling needed and the box's GPU is reserved for vLLM.
ExecStart=%h/opt/ollama/bin/ollama serve
Restart=on-failure
RestartSec=3
StandardOutput=append:%h/.ollama/ollama.log
StandardError=append:%h/.ollama/ollama.log

[Install]
WantedBy=default.target
